<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VAGAX EXECUTOR</title>
    <style>
        :root { --main: #8a2be2; --bg: #0d0d0d; --panel: #1a1a1a; }
        body { background-color: var(--bg); color: #fff; font-family: 'Segoe UI', sans-serif; margin: 0; overflow: hidden; }
        
        /* HEADER & LOGO */
        .header { background: var(--panel); padding: 15px; display: flex; align-items: center; border-bottom: 2px solid var(--main); }
        .logo { width: 40px; height: 40px; background: var(--main); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 20px; margin-right: 15px; box-shadow: 0 0 10px var(--main); }
        
        /* SEARCH BAR */
        .search-container { padding: 10px; }
        input#scriptSearch { width: 95%; padding: 10px; background: #222; border: 1px solid var(--main); color: #fff; border-radius: 5px; outline: none; }

        /* EDITOR BOX */
        .editor { width: 90%; height: 200px; margin: 10px auto; background: #000; border: 1px solid #333; padding: 10px; color: #00ff00; font-family: 'Courier New'; overflow-y: auto; border-radius: 5px; }

        /* BUTTONS */
        .btn-row { display: flex; justify-content: space-around; padding: 10px; }
        button { padding: 10px 20px; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; transition: 0.3s; }
        .btn-exec { background: var(--main); color: #fff; }
        .btn-clear { background: #444; color: #fff; }

        /* SCRIPT LIST */
        .script-list { height: 150px; overflow-y: auto; padding: 10px; border-top: 1px solid #333; }
        .script-item { background: #1a1a1a; padding: 10px; margin-bottom: 5px; border-radius: 4px; border-left: 3px solid var(--main); display: flex; justify-content: space-between; }
        
        .footer { font-size: 10px; text-align: center; color: #555; padding: 10px; }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo">V</div>
        <div style="font-size: 20px; font-weight: bold;">VAGAX EXECUTOR <span style="color:var(--main); font-size: 12px;">[KEYLESS]</span></div>
    </div>

    <div class="search-container">
        <input type="text" id="scriptSearch" placeholder="Search Scripts (FE, Aim, ESP)..." onkeyup="searchScript()">
    </div>

    <div class="editor" contenteditable="true" id="editor">
-- Vagax Executor Loaded
-- Developed by tubles93_txt
print("Hello, Roblox World!")
    </div>

    <div class="btn-row">
        <button class="btn-exec" onclick="execute()">EXECUTE</button>
        <button class="btn-clear" onclick="clearEditor()">CLEAR</button>
        <button class="btn-clear" style="background:#28a745" onclick="alert('Status: Active & Keyless!')">INJECT</button>
    </div>

    <div class="script-list" id="list">
        <div class="script-item"><span>Infinite Yield</span><button onclick="loadScript('inf')">Load</button></div>
        <div class="script-item"><span>Fly Script</span><button onclick="loadScript('fly')">Load</button></div>
        <div class="script-item"><span>Speed Hack</span><button onclick="loadScript('spd')">Load</button></div>
    </div>

    <div class="footer">BY: tubles93_txt | VAGAX CORE V1.0</div>

    <script>
        function execute() {
            const code = document.getElementById('editor').innerText;
            alert("EXECUTING:\n" + code.substring(0, 50) + "...");
            // Logika simulasi eksekusi
        }

        function clearEditor() {
            document.getElementById('editor').innerText = "";
        }

        function loadScript(type) {
            let ed = document.getElementById('editor');
            if(type === 'inf') ed.innerText = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source"))()';
            if(type === 'fly') ed.innerText = '-- Fly Script Activated\nlocal p = game.Players.LocalPlayer...';
            if(type === 'spd') ed.innerText = 'game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 100';
        }

        function searchScript() {
            let input = document.getElementById('scriptSearch').value.toLowerCase();
            let items = document.getElementsByClassName('script-item');
            for (let i = 0; i < items.length; i++) {
                if (!items[i].innerHTML.toLowerCase().includes(input)) {
                    items[i].style.display = "none";
                } else {
                    items[i].style.display = "flex";
                }
            }
        }
    </script>
</body>
</html>
